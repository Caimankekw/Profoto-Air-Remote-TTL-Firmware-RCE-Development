    {
      "id": "F_NATIVE_IDLE_AND_LCD",
      "resolved": true,
      "summary": "F 0x8618 expands only TTL/DEF/AIR1 native idle eligibility. Original deadline polling is retained; 0x8636 branches on core return before restoring context. LCD RAM087 OR 2A uses original selection-box bits."
    },
    {
      "id": "ALL_MODEL_IDLE_RETRY",
      "resolved": true,
      "summary": "N 7B72, O 7FBE, S 807A and F 8636 preserve the original deadline or expired FFFF latch when clearing is refused. Successful clear resumes original disarm. No busy loop or new hardware timer."
    },
    {
      "id": "FRESH_IDLE_GATE",
      "resolved": true,
      "summary": "Shared idle_expired refreshes read_inputs and requires edit plus radio readiness after magic/AIR2 checks. Ordinary edit admission is unchanged; AIR2 retains its original cleanup behavior."
    },
